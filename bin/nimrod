#!/usr/bin/env bash
# Directory launcher and synchronous action client. The app owns routing and IPC.
set -euo pipefail

usage() {
  printf '%s\n' 'Usage: nimrod [DIRECTORY]' '       nimrod -- DIRECTORY' \
    '       nimrod --action reload-customizations [--project DIRECTORY] [--json]' '' \
    'Open or focus a project. Defaults to the current directory.' \
    'No session is started or resumed.' \
    'Actions target an already-open project, wait for completion and never open/focus a window.' \
    'The action project defaults to the current directory.' '' \
    'NIMROD_APP overrides the .app location on macOS, or executable on Linux.'
}
fail() { printf 'nimrod: %s\n' "$*" >&2; exit 1; }

if [[ $# -eq 1 && ( $1 == --help || $1 == -h ) ]]; then usage; exit 0; fi
action_mode=false
for arg in "$@"; do
  [[ $arg != -- ]] || break
  if [[ $arg == --action ]]; then action_mode=true; break; fi
done
if [[ $action_mode == false ]]; then
  if [[ ${1-} == -- ]]; then
    shift
  elif [[ ${1-} == -* ]]; then
    fail 'Unknown option. Use nimrod --help.'
  fi
  [[ $# -le 1 ]] || fail 'Expected one project directory. Use nimrod --help.'
  requested=${1-.}
  [[ -n $requested && -d $requested ]] || fail "Not a project directory: $requested"
  workspace=$(CDPATH= cd -P -- "$requested" && pwd -P) || fail "Cannot open project: $requested"
fi

# Resolve an installed symlink to its checkout or packaged resource, including relative links.
source_path=${BASH_SOURCE[0]}
while [[ -L $source_path ]]; do
  source_dir=$(CDPATH= cd -P -- "$(dirname "$source_path")" && pwd -P)
  source_path=$(readlink "$source_path")
  [[ $source_path == /* ]] || source_path=$source_dir/$source_path
done
repo=$(CDPATH= cd -P -- "$(dirname "$source_path")/.." && pwd -P)

case $(uname -s) in
  Darwin)
    if [[ $repo == *.app/Contents/Resources ]]; then
      default_app=${repo%/Contents/Resources}
    else
      default_app=$repo/src-tauri/target/release/bundle/macos/Nimrod.app
    fi
    app=${NIMROD_APP:-$default_app}
    [[ -d $app && -x $app/Contents/MacOS/nimrod ]] || fail "Build not found at $app. Install/build Nimrod or set NIMROD_APP."
    app=$(CDPATH= cd -P -- "$app" && pwd -P)
    # --args alone is ignored for an already-running app. The transient second
    # launch forwards through Nimrod's pre-runtime instance gate, then exits.
    if [[ $action_mode == true ]]; then
      # Direct executable invocation returns the action result, without Launch Services/UI.
      exec "$app/Contents/MacOS/nimrod" "$@"
    else
      exec /usr/bin/open -n -a "$app" --args --workspace "$workspace"
    fi
    ;;
  Linux)
    app=${NIMROD_APP:-$repo/src-tauri/target/release/nimrod}
    [[ -f $app && -x $app ]] || fail "Executable not found at $app. Build Nimrod or set NIMROD_APP."
    if [[ $action_mode == true ]]; then
      exec "$app" "$@"
    else
      nohup "$app" --workspace "$workspace" </dev/null >/dev/null 2>&1 &
    fi
    ;;
  *) fail 'This launcher currently supports macOS and Linux.' ;;
esac
