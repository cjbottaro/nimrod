{
  "name": "Dracula",
  "type": "dark",
  "colors": {
    "foreground": "#f8f8f2",
    "editor.foreground": "#f8f8f2",
    "editor.background": "#282a36",
    "descriptionForeground": "#a4afd0",
    "focusBorder": "#bd93f9",
    "errorForeground": "#ff5555",
    "editorWidget.background": "#21222c",
    "editorGroupHeader.tabsBackground": "#21222c",
    "editorCodeLens.foreground": "#6272a4",
    "editorIndentGuide.background1": "#44475a",
    "editor.selectionBackground": "#44475a",
    "editorWarning.foreground": "#ffb86c",
    "input.background": "#21222c",
    "input.foreground": "#f8f8f2",
    "input.border": "#44475a",
    "button.background": "#44475a",
    "button.foreground": "#f8f8f2",
    "button.hoverBackground": "#6272a4",
    "button.secondaryBackground": "#343746",
    "button.secondaryForeground": "#f8f8f2",
    "button.secondaryHoverBackground": "#44475a",
    "panel.border": "#44475a",
    "widget.border": "#6272a4",
    "widget.shadow": "#191a2180",
    "progressBar.background": "#bd93f9",
    "textLink.foreground": "#8be9fd",
    "textLink.activeForeground": "#ff79c6",
    "textBlockQuote.background": "#343746",
    "textBlockQuote.border": "#bd93f9",
    "textCodeBlock.background": "#21222c",
    "toolbar.hoverBackground": "#44475a",
    "list.focusBackground": "#44475a",
    "list.focusForeground": "#f8f8f2",
    "testing.iconPassed": "#50fa7b",
    "testing.iconFailed": "#ff5555",
    "terminal.ansiGreen": "#50fa7b",
    "terminal.ansiRed": "#ff5555",
    "terminal.ansiYellow": "#f1fa8c"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#6272a4" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#ff79c6" } },
    { "scope": "string", "settings": { "foreground": "#f1fa8c" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#bd93f9" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#50fa7b" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#8be9fd" } },
    { "scope": "string.regexp", "settings": { "foreground": "#ffb86c" } }
  ]
}
